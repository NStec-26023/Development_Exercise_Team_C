<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fullness.stationary.repository.ProductModifyRepository">

<resultMap id="productResult" type="ProductStock">
<id property="stoId" column="sto_id"/>
<result property="quantity" column="quantity"/>
<result property="proId" column="pro_id"/>
<collection property="products" ofType="Product">
<id property="proId" column="pro_id"/>
<result property="name" column="name"/>
<result property="price" column="price"/>
<result property="imageUrl" column="imageUrl"/>
<result property="catId" column="cat_id"/>
<result property="deleteFlg" column="delete_flg"/>
</collection>
</resultMap>

<select id="selectByProIdWithProduct" parameterType="Integer" resultMap="productResult">
        
         <![CDATA[
        select *
        from product_stock a
        inner join product b
        on a.pro_id = b.pro_id
        where a.pro_id = #{proId}  
        ]]>

</select>

<select id="selectAllProductCategory" resultType="com.example.fullness.stationary.entity.ProductCategory">

        <![CDATA[
        SELECT * FROM product_category
        ]]>

</select>
<select id="selectCatNameByCatId" resultType="java.lang.String">

        <![CDATA[
        SELECT name FROM product_category
        WHERE cat_id = #{catId}

        ]]>

</select>

<update id="updateProductStock" parameterType="com.example.fullness.stationary.entity.ProductStock" >

        <![CDATA[
        UPDATE product_stock 
        SET 
        quantity = #{quantity}  
        WHERE 
            pro_id = #{proId}
        ]]>

</update>
<update id="updateProduct" parameterType="com.example.fullness.stationary.entity.Product" >

        <![CDATA[
        UPDATE product 
        SET 
            name = #{name},
            price = #{price},
            image_url = #{imageUrl},
            cat_id = #{catId}
        WHERE 
            pro_id = #{proId}
        ]]>

</update>
</mapper> 