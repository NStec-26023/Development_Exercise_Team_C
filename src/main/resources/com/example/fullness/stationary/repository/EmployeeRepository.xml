<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
"-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fullness.stationary.repository.EmployeeRepository">
<!-- 社員IDで社員１件取得 -->
  <select id="findByEmpId" resultType="com.example.fullness.stationary.entity.Employee">
         <![CDATA[
        SELECT * FROM employee
        WHERE emp_id = #{empId}
        ]]>
    </select>