<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
    "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.fullness.stationary.repository.EmployeeRepository">
	<!-- 未登録の社員取得 -->
    <select id="selectUnregisteredEmployeesl" resultType="com.example.fullness.stationary.entity.Employee">
        <!-- データベースコラムまだ更新してないから変えてね↓ -->
         <![CDATA[
        SELECT emp_id
        FROM employees 
        WHERE emp_id NOT IN (SELECT emp_id FROM employee_account)
        ]]>
    </select>

  </mapper>