<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fullness.stationary.repository.ProductSearchRepository">
<resultMap id="productCategoryResult" type="com.example.fullness.stationary.entity.ProductCategory">
        <id property="catId" column="cat_id" />
        <result property="name" column="name" />
</resultMap>
    <select id="selectAll" resultType="com.example.fullness.stationary.entity.Product">

        <![CDATA[
        SELECT * FROM product
        ]]>

    </select> 
    <select id="selectAllProductCategory" resultMap="productCategoryResult">

        <![CDATA[
        SELECT * FROM product_category
        ]]>

    </select>
    <select id="selectByCatId" resultType="com.example.fullness.stationary.entity.Product">

        <![CDATA[
        select * from Product
        WHERE cat_id = #{catId}
          
        ]]>

    </select>
  
    
</mapper> 