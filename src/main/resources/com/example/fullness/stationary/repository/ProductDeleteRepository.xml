<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
"-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fullness.stationary.repository.ProductDeleteRepository">

    
        <id property="stoId" column="sto_id"/>
        <result property="quantity" column="quantity"/>
        <result property="proId" column="pro_id"/>
        
            <result property="name" column="name"/>
            <result property="price" column="price"/>
            <result property="imageUrl" column="image_url"/>
            <result property="catId" column="cat_id"/>
            <result property="deleteFlg" column="delete_flg"/>
        </association>
    </resultMap>

    <select id="selectByProIdWithProduct" parameterType="Integer" resultMap="productResult">
        <![CDATA[
            SELECT 
                a.sto_id,
                a.quantity,
                a.pro_id,
                b.name,
                b.price,
                b.image_url,
                b.cat_id,
                b.delete_flg
            FROM product_stock a
            INNER JOIN product b ON a.pro_id = b.pro_id
            WHERE a.pro_id = #{proId}
        ]]>
    </select>

    <select id="getProductForDelete" parameterType="Integer" resultMap="productResult">
        <![CDATA[
            SELECT 
                a.sto_id,
                a.quantity,
                a.pro_id,
                b.name,
                b.price,
                b.image_url,
                b.cat_id,
                b.delete_flg
            FROM product_stock a
            INNER JOIN product b ON a.pro_id = b.pro_id
            WHERE a.pro_id = #{proId} AND b.delete_flg = 0
        ]]>
    </select>

    <update id="deleteById" parameterType="int">
        <![CDATA[
            UPDATE product 
            SET delete_flg = 1 
            WHERE pro_id = #{proId}
        ]]>
    </update>

</mapper>
