<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
"-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fullness.stationary.repository.EmployeeAccountRepository">
<!-- アカウント名で担当者１件取得 -->
    <select id="findByName" resultType="com.example.fullness.stationary.entity.EmployeeAccount">
         <![CDATA[
        SELECT * FROM employee_account
        WHERE name = #{name}
        ]]>
    </select>

<!-- 未登録の社員を抽出する -->
    <select id="selectUnregisteredEmployees" resultType="com.example.fullness.stationary.entity.Employee">
        <![CDATA[
      SELECT 
        e.emp_id AS empId,
            e.name, 
            e.kana, 
        e.dept_id AS deptId
        FROM 
            employee e
        LEFT JOIN 
            employee_account ea ON e.emp_id = ea.emp_id
        WHERE 
            ea.emp_id IS NULL
        ]]>
    </select>

<!-- アカウントデータを挿入するクエリ -->
    <insert id="insertAccount" parameterType="com.example.fullness.stationary.controller.form.EmployeeRegisterForm">
        <![CDATA[
       
        INSERT INTO employee_account (
            name, 
            password, 
            emp_id
        )VALUES( 
            #{accountName}, 
            #{password},
            #{empId}
        )
        ]]>
    </insert>


</mapper>