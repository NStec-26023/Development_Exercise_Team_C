<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
"-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fullness.stationary.repository.EmployeeAccountRepository">
    <resultMap id="EmployeeAccountResultMap" type="com.example.fullness.stationary.entity.EmployeeAccount">
        <id property="accId" column="acc_id" />
        <result property="name" column="name" />
        <result property="password" column="password" />
        <result property="empId" column="emp_id" />
    </resultMap>
<!-- 社員名で社員１件取得 -->
    <select id="findByName" resultMap="EmployeeAccountResultMap">
         <![CDATA[
        SELECT * FROM employee_account
        WHERE name = #{name}
        ]]>
    </select>

</mapper>